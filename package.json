{
  "name": "@ts-stack/body-parser",
  "type": "module",
  "description": "Node.js body parser writen in TypeScript, in promise style, in ESM format, without support Node.js version < 20.6.0.",
  "version": "1.2.0",
  "license": "MIT",
  "repository": "https://github.com/ts-stack/body-parser",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build-test": "tsc -b tsconfig.unit.json",
    "lint": "eslint .",
    "test": "npm run build-test && npm run esm-jest",
    "esm-jest": "node --env-file=.env --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps $(yarn bin jest)"
  },
  "keywords": [
    "ts-stack",
    "body-parser"
  ],
  "dependencies": {
    "@ts-stack/type-is": "^1.0.1",
    "bytes": "3.1.2",
    "content-type": "~1.0.5",
    "debug": "4.4.3",
    "http-errors": "2.0.1",
    "iconv-lite": "0.7.2",
    "qs": "6.15.1"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.5",
    "@types/content-type": "^1.1.9",
    "@types/debug": "^4.1.13",
    "@types/eslint": "^9.6.1",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/methods": "^1.1.4",
    "@types/node": "^25.6.2",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "methods": "1.1.2",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "safe-buffer": "^5.2.1",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 20.6.0"
  },
  "packageManager": "yarn@4.14.1"
}
